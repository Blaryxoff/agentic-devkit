#!/usr/bin/env bash
# devkit-toolkit: Codex (OpenAI) adapter
#
# Generates project-scoped skill links and AGENTS.md conduct references from
# resolved plugins. Core skills remain globally installed by bin/devkit-install.
#
# Output (in PROJECT_ROOT):
#   .codex/skills/devkit-*--*/ — symlinks for resolved non-core plugins
#   AGENTS.md                   — appends/updates ## devkit-toolkit section
#                                 (includes conduct references and hook instructions)
#
# Input config:
#   .devkit/toolkit.json                     — standard devkit project config
#
# Resolution logic:
#   - Sources adapters/_lib/resolve.sh for plugin resolution
#   - Core skills are global in ~/.codex/skills/devkit-core--*
#   - Resolved non-core plugin skills are linked under PROJECT_ROOT/.codex/skills
#   - AGENTS.md gets a managed section listing one conduct index per plugin
#   - Plugin hooks are described in AGENTS.md as instructions (Codex lacks native hook support)

set -euo pipefail

ADAPTER_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$ADAPTER_DIR/../_lib/resolve.sh"
source "$ADAPTER_DIR/../_lib/hooks.sh"

# Conduct paths embedded in AGENTS.md use the stable global-clone reference
# (e.g. ~/.claude/agentic-devkit) so the committed file is portable across
# machines. Skill symlinks use absolute paths into the active toolkit checkout.
DEVKIT_REF=$(toolkit_home_ref)

echo "==> Codex adapter: generating config..."
echo "    Toolkit: $TOOLKIT_ROOT"
echo "    Project: $PROJECT_ROOT"
echo ""

plugin_index=$(_build_plugin_index)
resolved_names=$(resolve_plugins)
resolved_non_core=$(printf '%s\n' "$resolved_names" | grep -v '^devkit-core$' || true)

skills_dir="$PROJECT_ROOT/.codex/skills"

# Fail before rebuilding links when a user-authored path occupies a required
# managed destination. Continuing would leave the enabled skill unavailable.
collision=0
while IFS= read -r name; do
  [ -z "$name" ] && continue
  plugin_data=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  plugin_dir=$(echo "$plugin_data" | jq -r '._dir')
  skills_src="$plugin_dir/skills"
  [ -d "$skills_src" ] || continue
  for skill_dir in "$skills_src"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_dest="$skills_dir/${name}--$(basename "$skill_dir")"
    if { [ -e "$skill_dest" ] || [ -L "$skill_dest" ]; } && [ ! -L "$skill_dest" ]; then
      echo "ERROR: enabled skill destination is occupied by a non-symlink: $skill_dest" >&2
      collision=1
    fi
  done
done <<< "$resolved_non_core"
[ "$collision" -eq 0 ] || exit 1

# Rebuild only managed links so disabled plugins disappear while user-authored
# .codex content remains untouched.
mkdir -p "$skills_dir"
reaped=0
for _l in "$skills_dir"/devkit-*--*; do
  [ -L "$_l" ] || continue
  rm -f "$_l"
  reaped=$((reaped + 1))
done
[ "$reaped" -gt 0 ] && echo "    Removed: $reaped stale .codex/skills/devkit-*--* symlink(s)"

linked=0
while IFS= read -r name; do
  [ -z "$name" ] && continue
  plugin_data=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  plugin_dir=$(echo "$plugin_data" | jq -r '._dir')
  skills_src="$plugin_dir/skills"
  [ -d "$skills_src" ] || continue
  for skill_dir in "$skills_src"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    skill_dest="$skills_dir/${name}--${skill_name}"
    ln -s "$(cd "$skill_dir" && pwd)" "$skill_dest"
    linked=$((linked + 1))
  done
done <<< "$resolved_non_core"
echo "    Linked:  .codex/skills/devkit-*--* ($linked resolved non-core skill(s))"

agents_file="$PROJECT_ROOT/AGENTS.md"
conduct_lines=""

while IFS= read -r name; do
  [ -z "$name" ] && continue
  plugin_data=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  plugin_dir=$(echo "$plugin_data" | jq -r '._dir')
  plugin_basename=$(basename "$plugin_dir")
  rel_plugin="$DEVKIT_REF/plugins/$plugin_basename"

  has_conduct=$(echo "$plugin_data" | jq 'has("paths") and (.paths | has("conduct"))')

  # --- Collect conduct references ---
  if [ "$has_conduct" = "true" ]; then
    conduct_abs="$plugin_dir/conduct"
    conduct_rel="$rel_plugin/conduct"
    if [ -d "$conduct_abs" ]; then
      conduct_lines="${conduct_lines}\n### ${name}\n"
      if [ -f "$conduct_abs/overview.md" ]; then
        conduct_lines="${conduct_lines}\n- ${conduct_rel}/overview.md"
      else
        echo "ERROR: conduct directory has no overview.md index: $conduct_abs" >&2
        exit 1
      fi
      conduct_lines="${conduct_lines}\n"
    fi
  fi

done <<< "$resolved_names"

# --- Collect hook instructions for AGENTS.md (Codex lacks native hooks) ---
merged_hooks=$(merge_plugin_hooks "$plugin_index" "$resolved_names")
has_hooks=$(echo "$merged_hooks" | jq 'length > 0')
hook_instructions=""

if [ "$has_hooks" = "true" ]; then
  hook_instructions="\n### Verification hooks\n\nThe following checks should be run at the specified lifecycle points:\n"
  hook_instructions="${hook_instructions}$(flatten_hooks_for_text "$merged_hooks" | while IFS='|' read -r event matcher cmd; do
    if [ -n "$matcher" ]; then
      printf '\n**%s** (when tool matches `%s`):\n- `%s`' "$event" "$matcher" "$cmd"
    else
      printf '\n**%s:**\n- `%s`' "$event" "$cmd"
    fi
  done)"
  hook_instructions="${hook_instructions}\n"
fi

# --- Update AGENTS.md ---
SECTION_START="<!-- devkit-toolkit:start -->"
SECTION_END="<!-- devkit-toolkit:end -->"
skill_policy=$(< "$ADAPTER_DIR/../../plugins/core/hooks/skill-eval.txt")
skill_policy=${skill_policy//\{\{DEVKIT_HOME\}\}/$DEVKIT_REF}

new_section="${SECTION_START}
## devkit-toolkit

${skill_policy}

Enabled plugins define eligible conduct, not mandatory context. Follow the loading policy below only when the task
touches that plugin. Start from its index and open further documents only for concrete layers or risks; never read a
conduct directory wholesale.
$(echo -e "$conduct_lines")$(echo -e "$hook_instructions")
${SECTION_END}"

if [ -f "$agents_file" ]; then
  if grep -q "$SECTION_START" "$agents_file"; then
    # Replace existing section. Pass replacement via env var so we don't pick
    # up the trailing newline that <<< (and most heredocs) append — that
    # newline would accumulate one extra blank line per run.
    DEVKIT_REPLACEMENT="$new_section" AGENTS_FILE="$agents_file" \
      SECTION_START_RE="$SECTION_START" SECTION_END_RE="$SECTION_END" \
      python3 -c '
import os, re
agents = os.environ["AGENTS_FILE"]
start = os.environ["SECTION_START_RE"]
end = os.environ["SECTION_END_RE"]
replacement = os.environ["DEVKIT_REPLACEMENT"]
with open(agents) as f:
    content = f.read()
pattern = re.escape(start) + r".*?" + re.escape(end)
# Use a lambda so backslashes/group-refs in the replacement are not interpreted.
result = re.sub(pattern, lambda _m: replacement, content, count=1, flags=re.DOTALL)
with open(agents, "w") as f:
    f.write(result)
'
    echo "    Updated: AGENTS.md (devkit-toolkit section replaced)"
  else
    printf "\n%s\n" "$new_section" >> "$agents_file"
    echo "    Updated: AGENTS.md (devkit-toolkit section appended)"
  fi
else
  printf "# AGENTS\n\n%s\n" "$new_section" > "$agents_file"
  echo "    Created: AGENTS.md"
fi

echo ""
echo "Done. Codex will discover global core skills and project-scoped resolved skills."
echo "Start a new Codex session to refresh the available-skill catalog."
echo ""
echo "Resolved plugins:"
echo "$resolved_names" | while read -r name; do echo "  - $name"; done
