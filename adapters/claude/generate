#!/usr/bin/env bash
# devkit-toolkit: Claude Code adapter (per-project stack infra)
#
# In the global model, core skills + the `devkit` router live in ~/.claude
# (installed once by bin/devkit-install). This adapter emits only the
# stack-specific pieces that cannot be global, all referencing the global clone:
#
# Output (in PROJECT_ROOT):
#   .claude/settings.json   — merged hooks from resolved plugins
#   .claude/agents/*.md      — subagent wrappers for stack claudeSubagent skills
#   .mcp.json                — MCP servers upserted from resolved plugins
#
# It does NOT symlink skills: core skills are globally registered and stack
# skills are loaded on demand by the `devkit` router. A cleanup pass removes any
# .claude/skills/devkit-*--* symlinks left by older adapter versions.
#
# Input config:
#   .devkit/toolkit.json     — standard devkit project config
#
# Notes:
#   - LSP configs from resolved plugins are noted but not merged (manual step)
#   - Stale .claude-plugin/ marketplace artifacts from previous versions are removed

set -euo pipefail

ADAPTER_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$ADAPTER_DIR/../_lib/resolve.sh"
source "$ADAPTER_DIR/../_lib/hooks.sh"
source "$ADAPTER_DIR/../_lib/claude_agents.sh"

echo "==> Claude Code adapter: generating config..."
echo "    Toolkit: $TOOLKIT_ROOT"
echo "    Project: $PROJECT_ROOT"
echo ""

plugin_index=$(_build_plugin_index)
resolved_names=$(resolve_plugins)

ensure_gitignore_entry ".claude/"

# --- Clean up stale marketplace artifacts from previous adapter versions ---
# Earlier versions of this adapter shipped a Claude Code plugin marketplace
# manifest under .claude-plugin/ and expected the user to run /plugin install
# inside Claude Code. The current adapter uses bare-file autodiscovery instead.
# Remove the old artifacts so they can't drift out of sync with the new layout.
legacy_marketplace_dir="$PROJECT_ROOT/.claude-plugin"
if [ -d "$legacy_marketplace_dir" ]; then
  rm -f "$legacy_marketplace_dir/marketplace.json" "$legacy_marketplace_dir/.devkit-state.json"
  rmdir "$legacy_marketplace_dir" 2>/dev/null || true
fi

# --- Cleanup: remove per-project skill symlinks from older adapter versions ---
# Skills are no longer symlinked per project (core = global, stack = router).
# Reap only symlinks named with the <plugin>--<skill> convention; leave
# user-authored skill directories alone.
project_skills_dir="$PROJECT_ROOT/.claude/skills"
if [ -d "$project_skills_dir" ]; then
  reaped=0
  for entry in "$project_skills_dir"/devkit-*--*; do
    [ -L "$entry" ] || continue
    rm -f "$entry"
    reaped=$((reaped + 1))
  done
  [ "$reaped" -gt 0 ] && echo "    Removed: $reaped stale .claude/skills/devkit-*--* symlink(s)"
  rmdir "$project_skills_dir" 2>/dev/null || true
fi

# --- settings.json (hooks only — plugin permissions.deny is NOT merged) ---
settings_dir="$PROJECT_ROOT/.claude"
settings_file="$settings_dir/settings.json"

merged_hooks=$(merge_plugin_hooks "$plugin_index" "$resolved_names")
has_hooks=$(echo "$merged_hooks" | jq 'length > 0')

if [ -f "$settings_file" ]; then
  if [ "$has_hooks" = "true" ]; then
    updated=$(jq --argjson hooks "$merged_hooks" '.hooks = ((.hooks // {}) + $hooks)' "$settings_file")
    echo "$updated" | jq '.' > "$settings_file"
    echo "    Updated: .claude/settings.json (hooks)"
  fi
elif [ "$has_hooks" = "true" ]; then
  mkdir -p "$settings_dir"
  jq -n --argjson hooks "$merged_hooks" '{hooks: $hooks}' > "$settings_file"
  echo "    Created: .claude/settings.json"
fi

# --- .mcp.json (upsert plugin-declared MCP servers, preserve user entries) ---
plugin_mcp="{}"
while IFS= read -r name; do
  [ -z "$name" ] && continue
  pdata=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  mcp_rel=$(echo "$pdata" | jq -r '.paths.mcpServers // empty')
  [ -n "$mcp_rel" ] || continue
  pdir=$(echo "$pdata" | jq -r '._dir')
  mcp_path="$pdir/${mcp_rel#./}"
  [ -f "$mcp_path" ] || continue
  servers=$(jq '.mcpServers // {}' "$mcp_path")
  plugin_mcp=$(echo "$plugin_mcp" | jq --argjson s "$servers" '. * $s')
done <<< "$resolved_names"

mcp_count=$(echo "$plugin_mcp" | jq 'length')
if [ "$mcp_count" != "0" ]; then
  mcp_file="$PROJECT_ROOT/.mcp.json"
  if [ -f "$mcp_file" ]; then
    updated=$(jq --argjson s "$plugin_mcp" '.mcpServers = ((.mcpServers // {}) * $s)' "$mcp_file")
    echo "$updated" | jq '.' > "$mcp_file"
    echo "    Updated: .mcp.json ($mcp_count server(s) upserted)"
  else
    jq -n --argjson s "$plugin_mcp" '{mcpServers: $s}' > "$mcp_file"
    echo "    Created: .mcp.json ($mcp_count server(s))"
  fi
fi

# --- .claude/agents/*.md (subagent wrappers for STACK claudeSubagent skills) ---
# Core subagents are installed globally by bin/devkit-install; this adapter emits
# only the stack ones. Shared emit logic lives in adapters/_lib/claude_agents.sh.
agents_dir="$PROJECT_ROOT/.claude/agents"
resolved_non_core=$(echo "$resolved_names" | grep -v '^devkit-core$' || true)

written_agents=()
while IFS= read -r _a; do
  [ -n "$_a" ] && written_agents+=("$_a")
done < <(generate_subagents "$agents_dir" "$plugin_index" "$resolved_non_core")
if [ "${#written_agents[@]}" -gt 0 ]; then
  echo "    Generated: .claude/agents/ (${#written_agents[@]} stack subagent(s))"
  for a in "${written_agents[@]}"; do echo "      - $a"; done
fi

echo ""
echo "Resolved plugins:"
echo "$resolved_names" | while read -r name; do echo "  - $name"; done
echo ""
echo "Done. Stack hooks, agents, and MCP servers are written under the project's"
echo ".claude/ tree. Core skills + the 'devkit' router are global (bin/devkit-install);"
echo "stack skills load on demand via the router. Re-run only when the plugin set"
echo "or infra files change — skill/conduct edits propagate live from the clone."
