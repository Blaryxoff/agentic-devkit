#!/usr/bin/env bash
# devkit-toolkit: Claude Code adapter (per-project stack infra)
#
# In the global model, core skills + the `devkit` router live in ~/.claude
# (installed once by bin/devkit-install). This adapter emits only the
# stack-specific pieces that cannot be global, all referencing the global clone:
#
# Output (in PROJECT_ROOT):
#   .claude/settings.json    — merged hooks from resolved plugins
#   .claude/agents/*.md       — subagent wrappers for stack claudeSubagent skills
#   .claude/skills/devkit-*   — symlinks to inline (non-subagent) stack skills
#   .mcp.json                 — MCP servers upserted from resolved plugins
#
# Core skills stay globally registered (bin/devkit-install). Stack skills split by
# kind: isolation skills (claudeSubagent: true) become subagents; inline skills
# (coder, css-*) are symlinked into .claude/skills so they auto-match natively
# instead of relying on the `devkit` router. The router remains the fallback for
# multi-repo unions and frontmatter-name collisions.
#
# Input config:
#   .devkit/toolkit.json     — standard devkit project config
#
# Notes:
#   - LSP configs from resolved plugins are noted but not merged (manual step)
#   - Stale .claude-plugin/ marketplace artifacts from previous versions are removed

set -euo pipefail

ADAPTER_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$ADAPTER_DIR/../_lib/resolve.sh"
source "$ADAPTER_DIR/../_lib/hooks.sh"
source "$ADAPTER_DIR/../_lib/mcp.sh"
source "$ADAPTER_DIR/../_lib/claude_agents.sh"

echo "==> Claude Code adapter: generating config..."
echo "    Toolkit: $TOOLKIT_ROOT"
echo "    Project: $PROJECT_ROOT"
echo ""

plugin_index=$(_build_plugin_index)
resolved_names=$(resolve_plugins)
resolved_non_core=$(echo "$resolved_names" | grep -v '^devkit-core$' || true)

ensure_gitignore_entry ".claude/"

# --- Clean up stale marketplace artifacts from previous adapter versions ---
# Earlier versions of this adapter shipped a Claude Code plugin marketplace
# manifest under .claude-plugin/ and expected the user to run /plugin install
# inside Claude Code. The current adapter uses bare-file autodiscovery instead.
# Remove the old artifacts so they can't drift out of sync with the new layout.
legacy_marketplace_dir="$PROJECT_ROOT/.claude-plugin"
if [ -d "$legacy_marketplace_dir" ]; then
  rm -f "$legacy_marketplace_dir/marketplace.json" "$legacy_marketplace_dir/.devkit-state.json"
  rmdir "$legacy_marketplace_dir" 2>/dev/null || true
fi

# --- .claude/skills/*: symlink INLINE stack skills (non-subagent) ---
# Isolation skills (claudeSubagent: true) become real subagents below; they must
# NOT also be registered as skills. Inline skills (e.g. coder, css-*) edit code in
# the main context, so they can't be subagents — without native registration they
# rely on the `devkit` router remembering to load them. Symlink them per project
# so they auto-match like native skills; the symlink points into the global clone,
# so skill edits still propagate live. Only resolved non-core plugins are linked,
# so unrelated projects stay clean. Re-run the adapter when the plugin set changes.
project_skills_dir="$PROJECT_ROOT/.claude/skills"
# Reap any devkit-managed symlinks first (clean slate; handles disabled plugins
# and skills promoted to subagents), leaving user-authored skill dirs alone.
if [ -d "$project_skills_dir" ]; then
  for entry in "$project_skills_dir"/devkit-*--*; do
    [ -L "$entry" ] && rm -f "$entry"
  done
fi

# Track linked frontmatter names as a newline-delimited set (bash 3.2 — no assoc arrays).
_seen_skill_names=""
linked_skills=0
while IFS= read -r name; do
  [ -z "$name" ] && continue
  pdata=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  skills_rel=$(echo "$pdata" | jq -r '.paths.skills // empty')
  [ -n "$skills_rel" ] || continue
  pdir=$(echo "$pdata" | jq -r '._dir')
  skills_src="$pdir/${skills_rel#./}"
  [ -d "$skills_src" ] || continue
  for skill_dir in "$skills_src"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_md="$skill_dir/SKILL.md"
    [ -f "$skill_md" ] || continue
    # Skip isolation skills — they are emitted as subagents, not skills.
    grep -q "^claudeSubagent:[[:space:]]*true" "$skill_md" && continue
    # Collision guard: two plugins can share a frontmatter name (laravel & nuxt
    # both define devkit-coder). Registering both makes the skill ambiguous, so
    # link the first and warn on the rest rather than create a broken pair.
    fm_name=$(grep -m1 '^name:' "$skill_md" | sed 's/^name:[[:space:]]*//;s/[[:space:]]*$//')
    if printf '%s\n' "$_seen_skill_names" | grep -qxF "$fm_name"; then
      echo "    WARN: skill name '$fm_name' (from $name) collides with an earlier plugin — not linked (use the 'devkit' router for it)"
      continue
    fi
    _seen_skill_names="$_seen_skill_names$fm_name
"
    mkdir -p "$project_skills_dir"
    ln -s "$(cd "$skill_dir" && pwd)" "$project_skills_dir/${name}--$(basename "$skill_dir")"
    linked_skills=$((linked_skills + 1))
  done
done <<< "$resolved_non_core"
[ "$linked_skills" -gt 0 ] && echo "    Linked:  .claude/skills/devkit-*--* ($linked_skills inline stack skill(s))"
rmdir "$project_skills_dir" 2>/dev/null || true

# --- settings.json (hooks only — plugin permissions.deny is NOT merged) ---
settings_dir="$PROJECT_ROOT/.claude"
settings_file="$settings_dir/settings.json"

merged_hooks=$(merge_plugin_hooks "$plugin_index" "$resolved_names")
has_hooks=$(echo "$merged_hooks" | jq 'length > 0')

if [ -f "$settings_file" ]; then
  if [ "$has_hooks" = "true" ]; then
    existing_hooks=$(jq '.hooks // {}' "$settings_file")
    merged=$(merge_hooks_preserving_existing "$existing_hooks" "$merged_hooks")
    updated=$(jq --argjson hooks "$merged" '.hooks = $hooks' "$settings_file")
    echo "$updated" | jq '.' > "$settings_file"
    echo "    Updated: .claude/settings.json (hooks)"
  fi
elif [ "$has_hooks" = "true" ]; then
  mkdir -p "$settings_dir"
  jq -n --argjson hooks "$merged_hooks" '{hooks: $hooks}' > "$settings_file"
  echo "    Created: .claude/settings.json"
fi

# --- .mcp.json (upsert plugin-declared MCP servers, preserve user entries) ---
plugin_mcp=$(merge_plugin_mcp_servers "$plugin_index" "$resolved_names")
chrome_profile="$PROJECT_ROOT/.cursor/chrome-profile"

mcp_count=$(echo "$plugin_mcp" | jq 'length')
if [ "$mcp_count" != "0" ]; then
  ensure_gitignore_entry ".cursor/chrome-profile/"
  mcp_file="$PROJECT_ROOT/.mcp.json"
  if [ -f "$mcp_file" ]; then
    existing=$(jq '.mcpServers // {}' "$mcp_file")
    plugin_mcp=$(echo "$plugin_mcp" | jq --argjson e "$existing" '. * $e')
  fi
  plugin_mcp=$(apply_chrome_devtools_profile "$plugin_mcp" "$chrome_profile")
  if [ -f "$mcp_file" ]; then
    updated=$(jq --argjson s "$plugin_mcp" '.mcpServers = $s' "$mcp_file")
    echo "$updated" | jq '.' > "$mcp_file"
    echo "    Updated: .mcp.json ($mcp_count server(s) merged, per-project chrome profile)"
  else
    jq -n --argjson s "$plugin_mcp" '{mcpServers: $s}' > "$mcp_file"
    echo "    Created: .mcp.json ($mcp_count server(s), per-project chrome profile)"
  fi
fi

# --- .claude/agents/*.md (subagent wrappers for STACK claudeSubagent skills) ---
# Core subagents are installed globally by bin/devkit-install; this adapter emits
# only the stack ones. Shared emit logic lives in adapters/_lib/claude_agents.sh.
agents_dir="$PROJECT_ROOT/.claude/agents"

written_agents=()
while IFS= read -r _a; do
  [ -n "$_a" ] && written_agents+=("$_a")
done < <(generate_subagents "$agents_dir" "$plugin_index" "$resolved_non_core")
if [ "${#written_agents[@]}" -gt 0 ]; then
  echo "    Generated: .claude/agents/ (${#written_agents[@]} stack subagent(s))"
  for a in "${written_agents[@]}"; do echo "      - $a"; done
fi

echo ""
echo "Resolved plugins:"
echo "$resolved_names" | while read -r name; do echo "  - $name"; done
echo ""
echo "Done. Stack hooks, agents, MCP servers, and inline-skill symlinks are written"
echo "under the project's .claude/ tree. Core skills + the 'devkit' router are global"
echo "(bin/devkit-install); isolation stack skills are subagents and inline stack skills"
echo "are .claude/skills symlinks — the router is the fallback for multi-repo unions and"
echo "name collisions. Re-run only when the plugin set or infra files change — skill/"
echo "conduct edits propagate live from the clone."
