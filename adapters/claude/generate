#!/usr/bin/env bash
# devkit-toolkit: Claude Code adapter
#
# Generates Claude Code plugin marketplace and settings from resolved plugins.
#
# Output (in PROJECT_ROOT):
#   .claude-plugin/marketplace.json  — filtered marketplace for resolved plugins only
#   .claude/settings.json            — merged permissions.deny + hooks from resolved plugins
#
# Input config:
#   .devkit/toolkit.json               — standard devkit project config
#
# Resolution logic:
#   - Sources adapters/_lib/resolve.sh for plugin resolution
#   - Each resolved plugin with paths.skills becomes a marketplace entry
#   - source paths are relative from project root to the plugin directory
#   - Hooks from resolved plugins are merged into settings.json
#   - MCP servers from resolved plugins are upserted into project-root .mcp.json
#     (existing user-defined entries are preserved; plugin keys are overwritten)
#   - LSP configs from resolved plugins are noted but not merged (manual step)
#   - permissions.deny lists are merged from all resolved plugins' settings.json

set -euo pipefail

ADAPTER_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$ADAPTER_DIR/../_lib/resolve.sh"
source "$ADAPTER_DIR/../_lib/hooks.sh"

RELPATH=$(toolkit_relpath)

echo "==> Claude Code adapter: generating config..."
echo "    Toolkit: $TOOLKIT_ROOT"
echo "    Project: $PROJECT_ROOT"
echo ""

plugin_index=$(_build_plugin_index)
resolved_names=$(resolve_plugins)

ensure_gitignore_entry ".claude/"

# --- marketplace.json ---
marketplace_dir="$PROJECT_ROOT/.claude-plugin"
mkdir -p "$marketplace_dir"

plugins_json="[]"

while IFS= read -r name; do
  [ -z "$name" ] && continue
  plugin_data=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  plugin_dir=$(echo "$plugin_data" | jq -r '._dir')
  rel_source="$RELPATH/plugins/$(basename "$plugin_dir")"

  version=$(echo "$plugin_data" | jq -r '.version')
  desc=$(echo "$plugin_data" | jq -r '.description')
  has_skills=$(echo "$plugin_data" | jq 'has("paths") and (.paths | has("skills"))')

  if [ "$has_skills" = "true" ]; then
    plugins_json=$(echo "$plugins_json" | jq \
      --arg name "$name" \
      --arg source "./$rel_source" \
      --arg desc "$desc" \
      '. + [{name: $name, source: $source, description: $desc}]')
  fi
done <<< "$resolved_names"

marketplace=$(jq -n \
  --argjson plugins "$plugins_json" \
  '{name: "devkit", owner: {name: "devkit"}, plugins: $plugins}')

marketplace_file="$marketplace_dir/marketplace.json"
state_file="$marketplace_dir/.devkit-state.json"

prev_state="{}"
if [ -f "$state_file" ]; then
  prev_state=$(jq '.plugins // {}' "$state_file" 2>/dev/null || echo "{}")
fi

new_state="{}"
while IFS= read -r name; do
  [ -z "$name" ] && continue
  pdata=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  has_skills=$(echo "$pdata" | jq 'has("paths") and (.paths | has("skills"))')
  [ "$has_skills" = "true" ] || continue
  pver=$(echo "$pdata" | jq -r '.version')
  new_state=$(echo "$new_state" | jq --arg n "$name" --arg v "$pver" '.[$n] = $v')
done <<< "$resolved_names"

echo "$marketplace" | jq '.' > "$marketplace_file"
jq -n --argjson plugins "$new_state" '{plugins: $plugins}' > "$state_file"
echo "    Created: .claude-plugin/marketplace.json"

# --- settings.json (hooks only — plugin permissions.deny is NOT merged) ---
settings_dir="$PROJECT_ROOT/.claude"
settings_file="$settings_dir/settings.json"

merged_hooks=$(merge_plugin_hooks "$plugin_index" "$resolved_names")
has_hooks=$(echo "$merged_hooks" | jq 'length > 0')

if [ -f "$settings_file" ]; then
  if [ "$has_hooks" = "true" ]; then
    updated=$(jq --argjson hooks "$merged_hooks" '.hooks = $hooks' "$settings_file")
    echo "$updated" | jq '.' > "$settings_file"
    echo "    Updated: .claude/settings.json (hooks)"
  fi
elif [ "$has_hooks" = "true" ]; then
  mkdir -p "$settings_dir"
  jq -n --argjson hooks "$merged_hooks" '{hooks: $hooks}' > "$settings_file"
  echo "    Created: .claude/settings.json"
fi

# --- .mcp.json (upsert plugin-declared MCP servers, preserve user entries) ---
plugin_mcp="{}"
while IFS= read -r name; do
  [ -z "$name" ] && continue
  pdata=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  mcp_rel=$(echo "$pdata" | jq -r '.paths.mcpServers // empty')
  [ -n "$mcp_rel" ] || continue
  pdir=$(echo "$pdata" | jq -r '._dir')
  mcp_path="$pdir/${mcp_rel#./}"
  [ -f "$mcp_path" ] || continue
  servers=$(jq '.mcpServers // {}' "$mcp_path")
  plugin_mcp=$(echo "$plugin_mcp" | jq --argjson s "$servers" '. * $s')
done <<< "$resolved_names"

mcp_count=$(echo "$plugin_mcp" | jq 'length')
if [ "$mcp_count" != "0" ]; then
  mcp_file="$PROJECT_ROOT/.mcp.json"
  if [ -f "$mcp_file" ]; then
    updated=$(jq --argjson s "$plugin_mcp" '.mcpServers = ((.mcpServers // {}) * $s)' "$mcp_file")
    echo "$updated" | jq '.' > "$mcp_file"
    echo "    Updated: .mcp.json ($mcp_count server(s) upserted)"
  else
    jq -n --argjson s "$plugin_mcp" '{mcpServers: $s}' > "$mcp_file"
    echo "    Created: .mcp.json ($mcp_count server(s))"
  fi
fi

# --- .claude/agents/*.md (subagent wrappers for skills with claudeSubagent: true) ---
# Each devkit-managed agent file starts with a sentinel comment so we can safely
# delete only our generated files and leave any user-authored agents untouched.
agents_dir="$PROJECT_ROOT/.claude/agents"
agent_sentinel="<!-- devkit-managed: regenerated by adapters/claude/generate -->"

if [ -d "$agents_dir" ]; then
  for f in "$agents_dir"/*.md; do
    [ -f "$f" ] || continue
    if head -1 "$f" 2>/dev/null | grep -qF "$agent_sentinel"; then
      rm -f "$f"
    fi
  done
fi

emit_subagent() {
  local skill_file="$1"
  awk -v sentinel="$agent_sentinel" -v out_dir="$agents_dir" '
    BEGIN { depth=0; in_fm=0; subagent=0; collecting=""; cont="" }
    /^---[[:space:]]*$/ {
      depth++
      if (depth==1) { in_fm=1; next }
      if (depth==2) { in_fm=0; next }
    }
    in_fm && collecting != "" {
      if ($0 ~ /^[A-Za-z_][A-Za-z0-9_]*:/) {
        meta[collecting]=cont
        collecting=""; cont=""
        # fall through to process this line as a new key
      } else {
        line=$0
        sub(/^[[:space:]]+/, "", line)
        if (cont == "") cont=line; else cont=cont " " line
        next
      }
    }
    in_fm && /^claudeSubagent:[[:space:]]*true[[:space:]]*$/ { subagent=1; next }
    in_fm && /^name:/ { v=$0; sub(/^name:[[:space:]]*/,"",v); meta["name"]=v; next }
    in_fm && /^claudeSubagentTools:/ { v=$0; sub(/^claudeSubagentTools:[[:space:]]*/,"",v); meta["tools"]=v; next }
    in_fm && /^description:/ {
      v=$0; sub(/^description:[[:space:]]*/,"",v)
      if (v ~ /^[>|][-+]?[[:space:]]*$/) { collecting="description"; cont=""; next }
      meta["description"]=v; next
    }
    !in_fm { body = body $0 "\n" }
    END {
      if (collecting != "") meta[collecting]=cont
      if (!subagent) exit 0
      name=meta["name"]
      if (name == "") exit 0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      desc=meta["description"]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", desc)
      tools=meta["tools"]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", tools)
      out=out_dir "/" name ".md"
      printf "%s\n", sentinel > out
      printf "---\n" >> out
      printf "name: %s\n", name >> out
      if (desc != "") printf "description: %s\n", desc >> out
      if (tools != "") printf "tools: %s\n", tools >> out
      printf "---\n" >> out
      sub(/^\n+/, "", body)
      printf "%s", body >> out
      close(out)
      print name
    }
  ' "$skill_file"
}

written_agents=()
while IFS= read -r name; do
  [ -z "$name" ] && continue
  pdata=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  skills_rel=$(echo "$pdata" | jq -r '.paths.skills // empty')
  [ -n "$skills_rel" ] || continue
  pdir=$(echo "$pdata" | jq -r '._dir')
  skills_dir="$pdir/${skills_rel#./}"
  [ -d "$skills_dir" ] || continue
  for skill_md in "$skills_dir"/*/SKILL.md; do
    [ -f "$skill_md" ] || continue
    if ! grep -q "^claudeSubagent:[[:space:]]*true" "$skill_md"; then
      continue
    fi
    mkdir -p "$agents_dir"
    emitted=$(emit_subagent "$skill_md")
    [ -n "$emitted" ] && written_agents+=("$emitted")
  done
done <<< "$resolved_names"

if [ "${#written_agents[@]}" -gt 0 ]; then
  echo "    Generated: .claude/agents/ (${#written_agents[@]} subagent(s))"
  for a in "${written_agents[@]}"; do echo "      - $a"; done
fi

echo ""
echo "Resolved plugins:"
echo "$resolved_names" | while read -r name; do echo "  - $name"; done
echo ""

# Determine which plugins are new (need install) vs updated (need reinstall) vs unchanged
new_plugins=$(jq -n --argjson prev "$prev_state" --argjson new "$new_state" \
  '[$new | to_entries[] | select($prev[.key] == null) | .key]')
updated_plugins=$(jq -n --argjson prev "$prev_state" --argjson new "$new_state" \
  '[$new | to_entries[] | select($prev[.key] != null and $prev[.key] != .value) | .key]')
removed_plugins=$(jq -n --argjson prev "$prev_state" --argjson new "$new_state" \
  '[$prev | to_entries[] | select($new[.key] == null) | .key]')

new_count=$(echo "$new_plugins" | jq 'length')
updated_count=$(echo "$updated_plugins" | jq 'length')
removed_count=$(echo "$removed_plugins" | jq 'length')

if [ "$(echo "$prev_state" | jq 'length')" = "0" ]; then
  echo "Done. Run these commands inside Claude Code:"
  echo ""
  echo "  /plugin marketplace add ./"
  echo ""
  echo "  For each install prompt, choose: Install for you, in this repo only (local scope)"
  echo ""
  echo "$new_state" | jq -r 'keys[]' | while read -r pname; do
    echo "  /plugin install ${pname}@devkit"
  done
  echo "  /reload-plugins"
elif [ "$new_count" = "0" ] && [ "$updated_count" = "0" ] && [ "$removed_count" = "0" ]; then
  echo "Done. No plugin changes detected — nothing to install or update in Claude Code."
else
  echo "Done. Run these commands inside Claude Code:"
  echo ""
  echo "  /plugin marketplace update devkit"
  if [ "$new_count" != "0" ]; then
    echo "$new_plugins" | jq -r '.[]' | while read -r pname; do
      echo "  /plugin install ${pname}@devkit"
    done
  fi
  if [ "$updated_count" != "0" ]; then
    echo "$updated_plugins" | jq -r '.[]' | while read -r pname; do
      echo "  /plugin update ${pname}@devkit"
    done
  fi
  if [ "$removed_count" != "0" ]; then
    echo "$removed_plugins" | jq -r '.[]' | while read -r pname; do
      echo "  /plugin uninstall ${pname}@devkit"
    done
  fi
  echo "  /reload-plugins"
fi
