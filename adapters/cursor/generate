#!/usr/bin/env bash
# devkit-toolkit: Cursor adapter
#
# Generates Cursor rules (.mdc) and merged hooks from resolved plugins.
# Core skills are installed globally; resolved non-core skills are linked per project.
#
# Output (in PROJECT_ROOT):
#   .cursor/skills/devkit-*--*/        — symlinks for resolved non-core plugins
#   .cursor/rules/devkit-<plugin>.mdc  — one compact conduct-index rule per resolved plugin
#   .cursor/mcp.json                   — MCP servers with per-project chrome-devtools profile
#   .cursor/hooks/hooks.json           — merged hooks translated to Cursor event names
#
# Input config:
#   .devkit/toolkit.json               — standard devkit project config
#
# Resolution logic:
#   - Sources adapters/_lib/resolve.sh for plugin resolution
#   - For each resolved plugin with conduct, generates an .mdc rule that
#     routes Cursor through one index and scope-driven loading
#   - devkit-core.mdc is always generated with alwaysApply: true
#   - Core skills are global; non-core skills are project-scoped
#   - Hooks from resolved plugins are merged and translated to Cursor event names
#     (DRY adapter pattern: plugins define hooks once in Claude Code format,
#      each adapter translates to its target tool's event model)

set -euo pipefail

ADAPTER_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$ADAPTER_DIR/../_lib/resolve.sh"
source "$ADAPTER_DIR/../_lib/hooks.sh"
source "$ADAPTER_DIR/../_lib/mcp.sh"

# Conduct paths embedded in generated .mdc use the stable global-clone reference
# (e.g. ~/.claude/agentic-devkit) so output is identical regardless of where the
# project sits on disk. Skills are still symlinked by absolute path below.
DEVKIT_REF=$(toolkit_home_ref)
skill_policy=$(< "$ADAPTER_DIR/../../plugins/core/hooks/skill-eval.txt")
skill_policy=${skill_policy//\{\{DEVKIT_HOME\}\}/$DEVKIT_REF}

echo "==> Cursor adapter: generating config..."
echo "    Toolkit: $TOOLKIT_ROOT"
echo "    Project: $PROJECT_ROOT"
echo ""

plugin_index=$(_build_plugin_index)
resolved_names=$(resolve_plugins)
resolved_non_core=$(printf '%s\n' "$resolved_names" | grep -v '^devkit-core$' || true)

skills_dir="$PROJECT_ROOT/.cursor/skills"

# Fail before generating any project output when an enabled skill cannot be
# linked. A successful partial catalog is more dangerous than a clear failure.
collision=0
while IFS= read -r name; do
  [ -z "$name" ] && continue
  plugin_data=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  plugin_dir=$(echo "$plugin_data" | jq -r '._dir')
  skills_src="$plugin_dir/skills"
  [ -d "$skills_src" ] || continue
  for skill_dir in "$skills_src"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_dest="$skills_dir/${name}--$(basename "$skill_dir")"
    if { [ -e "$skill_dest" ] || [ -L "$skill_dest" ]; } && [ ! -L "$skill_dest" ]; then
      echo "ERROR: enabled skill destination is occupied by a non-symlink: $skill_dest" >&2
      collision=1
    fi
  done
done <<< "$resolved_non_core"
[ "$collision" -eq 0 ] || exit 1

ensure_gitignore_entry ".cursor/"

rules_dir="$PROJECT_ROOT/.cursor/rules"
mkdir -p "$rules_dir"

reaped_rules=0
for _rule in "$rules_dir"/devkit-*.mdc; do
  if [ -e "$_rule" ] || [ -L "$_rule" ]; then
    rm -f "$_rule"
    reaped_rules=$((reaped_rules + 1))
  fi
done
[ "$reaped_rules" -gt 0 ] && echo "    Removed: $reaped_rules stale .cursor/rules/devkit-*.mdc rule(s)"

# Rebuild project-scoped non-core skill links. Core skills remain global; stack
# skills are exposed only in projects whose toolkit resolves them.
mkdir -p "$skills_dir"
reaped=0
for _l in "$skills_dir"/devkit-*--*; do
  [ -L "$_l" ] || continue
  rm -f "$_l"
  reaped=$((reaped + 1))
done
[ "$reaped" -gt 0 ] && echo "    Removed: $reaped stale .cursor/skills/devkit-*--* symlink(s)"

linked=0
while IFS= read -r name; do
  [ -z "$name" ] && continue
  plugin_data=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  plugin_dir=$(echo "$plugin_data" | jq -r '._dir')
  skills_src="$plugin_dir/skills"
  [ -d "$skills_src" ] || continue
  for skill_dir in "$skills_src"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_dest="$skills_dir/${name}--$(basename "$skill_dir")"
    ln -s "$(cd "$skill_dir" && pwd)" "$skill_dest"
    linked=$((linked + 1))
  done
done <<< "$resolved_non_core"
[ "$linked" -gt 0 ] && echo "    Linked:  .cursor/skills/devkit-*--* ($linked resolved non-core skill(s))"
rmdir "$skills_dir" 2>/dev/null || true

# Glob patterns per plugin (used for rule activation)
declare_globs() {
  local name=$1
  case "$name" in
    devkit-core)      echo '**/*' ;;
    devkit-frontend)  echo '**/*.vue,**/*.ts,**/*.tsx,**/*.js,**/*.jsx,**/*.css,**/*.scss' ;;
    devkit-laravel)   echo '**/*.php,app/**,routes/**,database/**,config/**' ;;
    devkit-nuxt)      echo '**/*.vue,**/*.ts,pages/**,composables/**,components/**' ;;
    devkit-vue)       echo '**/*.vue,**/*.ts,components/**,composables/**' ;;
    devkit-inertia)   echo '**/*.vue,**/*.ts,**/*.php,resources/**' ;;
    devkit-tailwind)  echo '**/*.vue,**/*.css,**/*.scss,**/*.html' ;;
    *)              echo '**/*' ;;
  esac
}

while IFS= read -r name; do
  [ -z "$name" ] && continue
  plugin_data=$(echo "$plugin_index" | jq --arg name "$name" '.[$name]')
  plugin_dir=$(echo "$plugin_data" | jq -r '._dir')
  plugin_basename=$(basename "$plugin_dir")
  rel_plugin="$DEVKIT_REF/plugins/$plugin_basename"

  has_conduct=$(echo "$plugin_data" | jq 'has("paths") and (.paths | has("conduct"))')

  # --- Generate .mdc rule ---
  if [ "$has_conduct" = "true" ]; then
    conduct_rel="$rel_plugin/conduct"
    conduct_abs="$plugin_dir/conduct"

    globs=$(declare_globs "$name")
    desc=$(echo "$plugin_data" | jq -r '.description')

    always_apply="false"
    if [ "$name" = "devkit-core" ]; then
      always_apply="true"
    fi

    mdc_file="$rules_dir/${name}.mdc"

    {
      echo "---"
      echo "description: \"$name: $desc\""
      if [ "$always_apply" = "true" ]; then
        echo "alwaysApply: true"
      else
        echo "globs: [\"${globs//,/\", \"}\"]"
      fi
      echo "---"
      echo ""
      echo "# $name"
      echo ""
      if [ "$name" = "devkit-core" ]; then
        printf '%s\n' "$skill_policy"
        echo ""
      fi
      echo "Enabled plugins define eligible conduct, not mandatory context. Open this index only when the task touches"
      echo "the plugin, then load further documents only for concrete layers or risks. Never read the directory wholesale."
      echo ""
      if [ -d "$conduct_abs" ]; then
        if [ -f "$conduct_abs/overview.md" ]; then
          echo "- $conduct_rel/overview.md"
        else
          echo "ERROR: conduct directory has no overview.md index: $conduct_abs" >&2
          exit 1
        fi
      fi
    } > "$mdc_file"
    echo "    Created: .cursor/rules/${name}.mdc"
  fi

done <<< "$resolved_names"

# --- Merge and translate hooks ---
merged_hooks=$(merge_plugin_hooks "$plugin_index" "$resolved_names")
cursor_hooks=$(translate_hooks_to_cursor "$merged_hooks")

# Auto-update global clone (+ project submodule) on workspace open and agent session start.
update_cmd="${HOME}/.claude/agentic-devkit/bin/devkit-update --if-stale"
cursor_hooks=$(echo "$cursor_hooks" | jq --arg cmd "$update_cmd" '
  def ensure_event($event):
    .[$event] = (
      (.[$event] // [])
      | map(select((.hooks // []) | any(.command == $cmd) | not))
    ) + [{ "hooks": [{ "type": "command", "command": $cmd, "timeout": 60000 }] }];
  ensure_event("sessionStart") | ensure_event("workspaceOpen")
')

hooks_dir="$PROJECT_ROOT/.cursor/hooks"
mkdir -p "$hooks_dir"
hooks_file="$hooks_dir/hooks.json"
echo "$cursor_hooks" | jq '.' > "$hooks_file"
hook_count=$(echo "$cursor_hooks" | jq '[.[] | length] | add // 0')
echo "    Created: .cursor/hooks/hooks.json ($hook_count hook(s), incl. devkit auto-update)"

# --- .cursor/mcp.json (per-project MCP servers; overrides global ~/.cursor/mcp.json) ---
plugin_mcp=$(merge_plugin_mcp_servers "$plugin_index" "$resolved_names")
chrome_profile='${workspaceFolder}/.cursor/chrome-profile'

mcp_count=$(echo "$plugin_mcp" | jq 'length')
if [ "$mcp_count" != "0" ]; then
  ensure_gitignore_entry ".cursor/chrome-profile/"
  cursor_dir="$PROJECT_ROOT/.cursor"
  mkdir -p "$cursor_dir"
  mcp_file="$cursor_dir/mcp.json"
  if [ -f "$mcp_file" ]; then
    existing=$(jq '.mcpServers // {}' "$mcp_file")
    plugin_mcp=$(echo "$plugin_mcp" | jq --argjson e "$existing" '. * $e')
  fi
  plugin_mcp=$(apply_chrome_devtools_profile "$plugin_mcp" "$chrome_profile")
  if [ -f "$mcp_file" ]; then
    updated=$(jq --argjson s "$plugin_mcp" '.mcpServers = $s' "$mcp_file")
    echo "$updated" | jq '.' > "$mcp_file"
    echo "    Updated: .cursor/mcp.json ($mcp_count server(s), per-project chrome profile)"
  else
    jq -n --argjson s "$plugin_mcp" '{mcpServers: $s}' > "$mcp_file"
    echo "    Created: .cursor/mcp.json ($mcp_count server(s), per-project chrome profile)"
  fi
fi

echo ""
echo "Done. Cursor discovers global core skills plus project-scoped resolved stack skills; project rules, MCP, and hooks generated here."
echo ""
echo "Resolved plugins:"
echo "$resolved_names" | while read -r name; do echo "  - $name"; done
