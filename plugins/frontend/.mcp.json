{
  "_comment": "MCP servers for the devkit-frontend plugin. Merged into project-root .mcp.json by adapters.",
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--pageIdRouting",
        "--isolated"
      ],
      "env": {}
    }
  }
}
