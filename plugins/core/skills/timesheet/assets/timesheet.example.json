  "calls": {"include": ["ghostflow:*", "telemost:1234567890@2026-08-26"]},

  "order": ["Platform", "Core (all brands)", "DevOps", "Alpha", "Beta", "Calls and team syncs"],
  "titles": {"Core (all brands)": "Общее ядро (все бренды)", "DevOps": "DevOps и инфраструктура"},
