#!/usr/bin/env bash
# devkit-install: set up global devkit installs for Claude Code and Codex CLI.
#
# Usage:
#   devkit-install              Install global pieces (Claude/Codex core skills,
#                               Claude subagents, daily auto-update hook).
#   devkit-install --cursor     Also run the per-project Cursor adapter for CWD.
#   devkit-install --codex      Also run the per-project Codex adapter for CWD.
#   devkit-install --claude     Also run the per-project Claude stack adapter for CWD
#                               (stack subagents, hooks, .mcp.json — core is global).
#   devkit-install --project=DIR Target project for --cursor/--codex/--claude (default: CWD).
#
# Global layout:
#   $HOME/.claude/skills/devkit-core--<skill>/     symlinks to core skills for Claude
#   $HOME/.claude/agents/<name>.md                 core subagent wrappers
#   $HOME/.claude/settings.json                    SessionStart hook → devkit-update --if-stale
#   $HOME/.claude/commands/<name>.md               slash commands (e.g. /wrapup)
#   $HOME/.codex/skills/devkit-core--<skill>/      symlinks to core skills for Codex
#   $HOME/.codex/config.toml                       PreToolUse hooks → coder-gate.sh, comment-gate.sh
#   $HOME/.cursor/skills/devkit-core--<skill>/     symlinks to core skills for Cursor
#   $HOME/.cursor/hooks/hooks.json                 preToolUse coder/comment gates
#
# The global clone is the single source of truth. devkit-install runs from the
# clone it lives in; if that is not the canonical location it bootstraps a clone
# at ~/.claude/agentic-devkit (override with DEVKIT_HOME_DIR) from origin.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TARGET="${DEVKIT_HOME_DIR:-$HOME/.claude/agentic-devkit}"

RUN_CURSOR=0
RUN_CODEX=0
RUN_CLAUDE=0
PROJECT="$(pwd)"
for arg in "$@"; do
  case "$arg" in
    --cursor)    RUN_CURSOR=1 ;;
    --codex)     RUN_CODEX=1 ;;
    --claude)    RUN_CLAUDE=1 ;;
    --project=*) PROJECT="${arg#--project=}" ;;
    -h|--help)
      sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

# --- Resolve / bootstrap the global clone ---
if [ "$SELF_ROOT" = "$TARGET" ]; then
  DEVKIT_HOME="$SELF_ROOT"
elif [ -d "$TARGET/.git" ]; then
  echo "==> Using existing global clone at $TARGET"
  DEVKIT_HOME="$TARGET"
else
  url=$(git -C "$SELF_ROOT" remote get-url origin 2>/dev/null || true)
  if [ -z "$url" ]; then
    echo "ERROR: no origin remote on $SELF_ROOT — clone devkit to $TARGET manually first." >&2
    exit 1
  fi
  echo "==> Cloning devkit into $TARGET"
  mkdir -p "$(dirname "$TARGET")"
  git clone -q "$url" "$TARGET"
  DEVKIT_HOME="$TARGET"
fi

DEVKIT_HOME_REAL="$(cd "$DEVKIT_HOME" && pwd -P)"

# A relocated or symlinked clone leaves links whose raw target no longer starts with DEVKIT_HOME.
links_into_devkit() {
  [ -L "$1" ] || return 1
  local target dir
  target="$(readlink "$1")"
  case "$target" in
    "$DEVKIT_HOME"/*) return 0 ;;
    /*) ;;
    *) target="$(dirname "$1")/$target" ;;
  esac
  dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)" || return 1
  case "$dir/" in
    "$DEVKIT_HOME_REAL"/*) return 0 ;;
  esac
  return 1
}

source "$DEVKIT_HOME/adapters/_lib/resolve.sh"
source "$DEVKIT_HOME/adapters/_lib/hooks.sh"
source "$DEVKIT_HOME/adapters/_lib/claude_agents.sh"

echo "==> devkit-install"
echo "    Clone:   $DEVKIT_HOME"

CLAUDE_DIR="$HOME/.claude"
SKILLS_DEST="$CLAUDE_DIR/skills"
AGENTS_DEST="$CLAUDE_DIR/agents"
SETTINGS="$CLAUDE_DIR/settings.json"
CLAUDE_GUIDANCE="$CLAUDE_DIR/CLAUDE.md"
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
CODEX_SKILLS_DEST="$CODEX_DIR/skills"
CODEX_CONFIG="$CODEX_DIR/config.toml"
CODEX_LEGACY_HOOKS="$CODEX_DIR/hooks.json"
CURSOR_DIR="${CURSOR_HOME:-$HOME/.cursor}"
CURSOR_SKILLS_DEST="$CURSOR_DIR/skills"
mkdir -p "$SKILLS_DEST" "$CODEX_SKILLS_DEST" "$CURSOR_SKILLS_DEST"

# --- Symlink every core skill globally (universal + the devkit router) ---
core_skills_src="$DEVKIT_HOME/plugins/core/skills"
for entry in "$SKILLS_DEST"/devkit-core--*; do
  if [ -L "$entry" ]; then
    rm -f "$entry"
  fi
done
# Reap non-core links left by installs that exposed every plugin globally.
for entry in "$CODEX_SKILLS_DEST"/devkit-*--*; do
  [ -L "$entry" ] || continue
  entry_name=$(basename "$entry")
  case "$entry_name" in
    devkit-core--*)
      skill_name="${entry_name#devkit-core--}"
      [ -d "$core_skills_src/$skill_name" ] || rm -f "$entry"
      ;;
    *) rm -f "$entry" ;;
  esac
done
skill_count=0
codex_skill_count=0
skill_kept=""
codex_skill_kept=""
for d in "$core_skills_src"/*/; do
  [ -d "$d" ] || continue
  n=$(basename "$d")
  abs="$(cd "$d" && pwd)"
  claude_skill_dest="$SKILLS_DEST/devkit-core--$n"
  if [ -e "$claude_skill_dest" ] || [ -L "$claude_skill_dest" ]; then
    skill_kept="$skill_kept $n"
  else
    ln -s "$abs" "$claude_skill_dest"
    skill_count=$((skill_count + 1))
  fi
  codex_skill_dest="$CODEX_SKILLS_DEST/devkit-core--$n"
  if [ -L "$codex_skill_dest" ] && [ "$(readlink "$codex_skill_dest")" = "$abs" ]; then
    codex_skill_count=$((codex_skill_count + 1))
  else
    if [ -L "$codex_skill_dest" ]; then
      rm -f "$codex_skill_dest"
    fi
    if [ -e "$codex_skill_dest" ]; then
      codex_skill_kept="$codex_skill_kept $n"
    else
      ln -s "$abs" "$codex_skill_dest"
      codex_skill_count=$((codex_skill_count + 1))
    fi
  fi
done
echo "    Linked:  ~/.claude/skills/devkit-core--* ($skill_count skill(s))"
echo "    Linked:  ~/.codex/skills/devkit-core--*  ($codex_skill_count skill(s))"
if [ -n "$skill_kept$codex_skill_kept" ]; then
  echo "    NOTICE: kept non-devkit entries in the skills dir(s) for:$skill_kept$codex_skill_kept — remove them to let devkit link those skills."
fi

# --- Symlink core skills globally for Cursor ---
# Stack skills are linked per project by adapters/cursor/generate so unrelated
# projects do not carry their catalog metadata.
cursor_migrated_skill_count=0
for entry in "$CURSOR_SKILLS_DEST"/devkit-*--*; do
  [ -L "$entry" ] || continue
  case "$(basename "$entry")" in
    devkit-core--*) ;;
    *) cursor_migrated_skill_count=$((cursor_migrated_skill_count + 1)) ;;
  esac
  rm -f "$entry"
done
cursor_skill_count=0
cursor_skill_kept=""
for d in "$core_skills_src"/*/; do
  [ -d "$d" ] || continue
  n=$(basename "$d")
  abs="$(cd "$d" && pwd)"
  cursor_skill_dest="$CURSOR_SKILLS_DEST/devkit-core--$n"
  if [ -e "$cursor_skill_dest" ] || [ -L "$cursor_skill_dest" ]; then
    cursor_skill_kept="$cursor_skill_kept $n"
    continue
  fi
  ln -s "$abs" "$cursor_skill_dest"
  cursor_skill_count=$((cursor_skill_count + 1))
done
echo "    Linked:  ~/.cursor/skills/devkit-core--* ($cursor_skill_count skill(s))"
if [ -n "$cursor_skill_kept" ]; then
  echo "    NOTICE: kept non-devkit entries in ~/.cursor/skills for:$cursor_skill_kept"
fi
if [ "$cursor_migrated_skill_count" -gt 0 ]; then
  echo "    NOTICE: Cursor stack skills are now project-scoped; $cursor_migrated_skill_count old global link(s) were removed."
  echo "            Regenerate each Cursor project with: DEVKIT_PROJECT_ROOT=/path/to/project $DEVKIT_HOME/adapters/cursor/generate"
fi

# --- Core subagents → ~/.claude/agents (claudeSubagent skills keep isolation) ---
plugin_index=$(_build_plugin_index)
core_agents=()
while IFS= read -r _a; do
  [ -n "$_a" ] && core_agents+=("$_a")
done < <(generate_subagents "$AGENTS_DEST" "$plugin_index" "devkit-core")
if [ "${#core_agents[@]}" -gt 0 ]; then
  echo "    Agents:  ~/.claude/agents/ (${#core_agents[@]} core subagent(s))"
fi

# --- SessionStart auto-update hook in ~/.claude/settings.json ---
hook_cmd="$DEVKIT_HOME/bin/devkit-update --if-stale"
if [ -f "$SETTINGS" ]; then
  updated=$(jq --arg cmd "$hook_cmd" '
    .hooks //= {} |
    .hooks.SessionStart = (
      ((.hooks.SessionStart // []) | map(select(
        (.hooks // []) | any(.command == $cmd) | not
      )))
      + [ { hooks: [ { type: "command", command: $cmd } ] } ]
    )
  ' "$SETTINGS")
  printf '%s\n' "$updated" | jq '.' > "$SETTINGS"
  echo "    Hook:    ~/.claude/settings.json (SessionStart auto-update)"
else
  jq -n --arg cmd "$hook_cmd" \
    '{hooks: {SessionStart: [ { hooks: [ { type: "command", command: $cmd } ] } ]}}' > "$SETTINGS"
  echo "    Hook:    ~/.claude/settings.json created (SessionStart auto-update)"
fi

# --- Static skill policy in ~/.claude/CLAUDE.md ---
# Anthropic recommends CLAUDE.md for instructions that do not change. Keep one
# managed section globally instead of injecting the same policy on every prompt.
policy_start="<!-- devkit-skill-policy:start -->"
policy_end="<!-- devkit-skill-policy:end -->"
skill_policy=$(< "$DEVKIT_HOME/plugins/core/hooks/skill-eval.txt")
skill_policy=${skill_policy//\{\{DEVKIT_HOME\}\}/$DEVKIT_HOME}
policy_section="${policy_start}
## devkit skill policy

${skill_policy}
${policy_end}"

if [ -f "$CLAUDE_GUIDANCE" ]; then
  if grep -qF "$policy_start" "$CLAUDE_GUIDANCE"; then
    DEVKIT_REPLACEMENT="$policy_section" CLAUDE_GUIDANCE_FILE="$CLAUDE_GUIDANCE" \
      POLICY_START="$policy_start" POLICY_END="$policy_end" \
      python3 -c '
import os, re
path = os.environ["CLAUDE_GUIDANCE_FILE"]
start = os.environ["POLICY_START"]
end = os.environ["POLICY_END"]
replacement = os.environ["DEVKIT_REPLACEMENT"]
with open(path) as f:
    content = f.read()
pattern = re.escape(start) + r".*?" + re.escape(end)
updated, count = re.subn(pattern, lambda _m: replacement, content, count=1, flags=re.DOTALL)
if count != 1:
    raise SystemExit("managed devkit skill policy is malformed")
with open(path, "w") as f:
    f.write(updated)
'
  else
    printf '\n\n%s\n' "$policy_section" >> "$CLAUDE_GUIDANCE"
  fi
else
  printf '%s\n' "$policy_section" > "$CLAUDE_GUIDANCE"
fi
echo "    Guidance: ~/.claude/CLAUDE.md (managed devkit skill policy)"

# Managed hooks are matched by script name rather than by absolute path, so relocating
# DEVKIT_HOME replaces the old command instead of leaving a dangling one behind, and
# only our own hook object is dropped — a user hook sharing the entry survives.
hook_command() {
  printf "sh '%s'" "$(printf '%s' "$DEVKIT_HOME/plugins/core/hooks/$1" | sed "s/'/'\\\\''/g")"
}

# Reassert the compact activation gate on each prompt. The full policy remains in
# CLAUDE.md; this hook is intentionally one line to avoid prompt bloat.
skilleval_cmd=$(hook_command skill-eval.sh)
updated=$(jq --arg cmd "$skilleval_cmd" --arg script "skill-eval.sh" '
  .hooks //= {} |
  .hooks.UserPromptSubmit = (
    ((.hooks.UserPromptSubmit // []) | map(
      .hooks = ((.hooks // []) | map(select(
        (.command // "") | contains("plugins/core/hooks/" + $script) | not
      )))
    ) | map(select((.hooks | length) > 0)))
    + [ { hooks: [ { type: "command", command: $cmd } ] } ]
  )
' "$SETTINGS")
printf '%s\n' "$updated" | jq '.' > "$SETTINGS"
echo "    Hook:    ~/.claude/settings.json (UserPromptSubmit skill activation gate)"

# --- PreToolUse coder-gate hook in ~/.claude/settings.json ---
# Hard-gates code edits until the coder skill is recorded in the session transcript.
codergate_cmd=$(hook_command coder-gate.sh)
updated=$(jq --arg cmd "$codergate_cmd" --arg script "coder-gate.sh" '
  .hooks //= {} |
  .hooks.PreToolUse = (
    ((.hooks.PreToolUse // []) | map(
      .hooks = ((.hooks // []) | map(select(
        (.command // "") | contains("plugins/core/hooks/" + $script) | not
      )))
    ) | map(select((.hooks | length) > 0)))
    + [ { matcher: "Edit|Write|MultiEdit", hooks: [ { type: "command", command: $cmd } ] } ]
  )
' "$SETTINGS")
printf '%s\n' "$updated" | jq '.' > "$SETTINGS"
echo "    Hook:    ~/.claude/settings.json (PreToolUse coder-gate)"

# --- PreToolUse comment-gate hook in ~/.claude/settings.json ---
# Rejects edits that add change-narrating comments; the rule itself lives in code-comments.md.
commentgate_cmd=$(hook_command comment-gate.sh)
updated=$(jq --arg cmd "$commentgate_cmd" --arg script "comment-gate.sh" '
  .hooks //= {} |
  .hooks.PreToolUse = (
    ((.hooks.PreToolUse // []) | map(
      .hooks = ((.hooks // []) | map(select(
        (.command // "") | contains("plugins/core/hooks/" + $script) | not
      )))
    ) | map(select((.hooks | length) > 0)))
    + [ { matcher: "Edit|Write|MultiEdit", hooks: [ { type: "command", command: $cmd } ] } ]
  )
' "$SETTINGS")
printf '%s\n' "$updated" | jq '.' > "$SETTINGS"
echo "    Hook:    ~/.claude/settings.json (PreToolUse comment-gate)"

# --- Global + project Cursor preToolUse edit gates ---
CURSOR_HOOKS_DIR="$CURSOR_DIR/hooks"
CURSOR_HOOKS_FILE="$CURSOR_HOOKS_DIR/hooks.json"
mkdir -p "$CURSOR_HOOKS_DIR"
cursor_hooks='{}'
if [ -f "$CURSOR_HOOKS_FILE" ]; then
  cursor_hooks=$(jq 'del(.version) | .hooks // .' "$CURSOR_HOOKS_FILE" 2>/dev/null || echo '{}')
fi
cursor_hooks=$(inject_cursor_edit_gates "$cursor_hooks" "$codergate_cmd" "$commentgate_cmd")
printf '%s\n' "$cursor_hooks" | jq '.' > "$CURSOR_HOOKS_FILE"
echo "    Hook:    ~/.cursor/hooks/hooks.json (preToolUse coder-gate + comment-gate)"

# --- PreToolUse hooks in ~/.codex/config.toml ---
CODEX_CONFIG_FILE="$CODEX_CONFIG" \
CODEX_LEGACY_HOOKS_FILE="$CODEX_LEGACY_HOOKS" \
CODEX_CODER_GATE_CMD="$codergate_cmd" \
CODEX_COMMENT_GATE_CMD="$commentgate_cmd" \
python3 - <<'PY'
import errno
import json
import os
import stat
from pathlib import Path

config_path = Path(os.environ["CODEX_CONFIG_FILE"])
legacy_path = Path(os.environ["CODEX_LEGACY_HOOKS_FILE"])
managed_start = "# devkit-hooks:start"
managed_end = "# devkit-hooks:end"
managed_scripts = ("coder-gate.sh", "comment-gate.sh")


def toml_value(value):
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    raise TypeError(f"unsupported hook value: {value!r}")


def render_group(event, group):
    lines = [f"[[hooks.{event}]]"]
    for key, value in group.items():
        if key != "hooks":
            lines.append(f"{key} = {toml_value(value)}")
    for hook in group.get("hooks", []):
        lines.extend(("", f"[[hooks.{event}.hooks]]"))
        lines.extend(f"{key} = {toml_value(value)}" for key, value in hook.items())
    return "\n".join(lines)


content = config_path.read_text() if config_path.exists() else ""
original = content
if managed_start in content:
    before, remainder = content.split(managed_start, 1)
    if managed_end not in remainder:
        raise SystemExit(f"malformed managed hook block in {config_path}")
    _, after = remainder.split(managed_end, 1)
    content = before.rstrip() + after

migrated = []
legacy_exists = legacy_path.exists()
if legacy_exists:
    lines = content.splitlines()
    kept_lines = []
    skip_state = False
    legacy_state_prefix = f'[hooks.state."{legacy_path}:'
    for line in lines:
        if line.startswith("["):
            skip_state = line.startswith(legacy_state_prefix)
        if not skip_state:
            kept_lines.append(line)
    content = "\n".join(kept_lines)

    legacy = json.loads(legacy_path.read_text())
    hooks = legacy.get("hooks", {})
    if not isinstance(hooks, dict):
        raise SystemExit(f"invalid hooks object in {legacy_path}")
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            raise SystemExit(f"invalid {event} hook groups in {legacy_path}")
        for group in groups:
            kept_hooks = [
                hook for hook in group.get("hooks", [])
                if not any(script in hook.get("command", "") for script in managed_scripts)
            ]
            if kept_hooks:
                migrated.append(render_group(event, {**group, "hooks": kept_hooks}))

managed = f'''{managed_start}
[[hooks.PreToolUse]]
matcher = "apply_patch|Edit|Write"

[[hooks.PreToolUse.hooks]]
type = "command"
command = {toml_value(os.environ["CODEX_CODER_GATE_CMD"])}
statusMessage = "Loading coding conduct"

[[hooks.PreToolUse]]
matcher = "apply_patch|Edit|Write"

[[hooks.PreToolUse.hooks]]
type = "command"
command = {toml_value(os.environ["CODEX_COMMENT_GATE_CMD"])}
statusMessage = "Checking comment rules"
{managed_end}'''

sections = [content.strip(), *migrated, managed]
updated = "\n\n".join(section for section in sections if section) + "\n"
config_path.parent.mkdir(parents=True, exist_ok=True)
tmp_path = config_path.with_name(config_path.name + ".devkit.tmp")
tmp_path.write_text(updated)
mode = stat.S_IMODE(config_path.stat().st_mode) if config_path.exists() else 0o600
tmp_path.chmod(mode)
RENAME_BLOCKED = (errno.EBUSY, errno.EXDEV)
UNWRITABLE = (errno.EROFS, errno.EACCES, errno.EPERM)
try:
    tmp_path.replace(config_path)
except OSError as exc:
    # EBUSY: config.toml is a bind-mount target; EXDEV: tmp and target on different filesystems.
    if exc.errno not in RENAME_BLOCKED:
        raise
    try:
        config_path.write_text(updated)
        config_path.chmod(mode)
    except OSError as inner:
        if inner.errno not in UNWRITABLE:
            raise
        tmp_path.unlink(missing_ok=True)
        if original == updated:
            print("    Hooks:   ~/.codex/config.toml (PreToolUse gates; already current, file is read-only)")
        else:
            print(f"    Hooks:   SKIPPED - {config_path} is not writable ({inner.strerror}).")
            print("             Append the devkit-hooks block to it from the host side.")
        raise SystemExit(0)
    tmp_path.unlink()
if legacy_exists:
    legacy_path.unlink()
print("    Hooks:   ~/.codex/config.toml (PreToolUse gates; review with /hooks)")
PY

# --- Output styles → ~/.claude/output-styles (symlinks) + default selection ---
# Ships the terse, language-mirroring «Laconica» output style.
# keep-coding-instructions:true inside the style file preserves Claude Code's coding behaviour.
OUTPUT_STYLES_SRC="$DEVKIT_HOME/plugins/core/output-styles"
OUTPUT_STYLES_DEST="$CLAUDE_DIR/output-styles"
if [ -d "$OUTPUT_STYLES_SRC" ]; then
  mkdir -p "$OUTPUT_STYLES_DEST"
  # Reap only symlinks that point back into this clone; never touch user-authored styles.
  for entry in "$OUTPUT_STYLES_DEST"/*; do
    if links_into_devkit "$entry"; then
      rm -f "$entry"
    fi
  done
  os_count=0
  os_kept=""
  for f in "$OUTPUT_STYLES_SRC"/*.md; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    if [ -e "$OUTPUT_STYLES_DEST/$base" ] || [ -L "$OUTPUT_STYLES_DEST/$base" ]; then
      os_kept="$os_kept ${base%.md}"
      continue
    fi
    ln -s "$f" "$OUTPUT_STYLES_DEST/$base"
    os_count=$((os_count + 1))
  done
  echo "    Linked:  ~/.claude/output-styles/*.md ($os_count style(s))"
  if [ -n "$os_kept" ]; then
    echo "    NOTICE: kept your own ~/.claude/output-styles file(s) for:$os_kept — devkit did not overwrite them."
  fi

  # Make «Laconica» the default when unset and migrate the previous devkit-managed name.
  # Any other explicit outputStyle remains untouched.
  style_default="Laconica"
  updated=$(jq --arg s "$style_default" '
    if .outputStyle == null or .outputStyle == "Laconica RU"
    then .outputStyle = $s
    else .
    end
  ' "$SETTINGS")
  printf '%s\n' "$updated" | jq '.' > "$SETTINGS"
  echo "    Style:   ~/.claude/settings.json (default outputStyle → $style_default)"
fi

# --- Slash commands → ~/.claude/commands ---
# Codex has no custom-command directory; there a skill is invoked as $<frontmatter-name>.
COMMANDS_SRC="$DEVKIT_HOME/plugins/core/commands"
COMMANDS_DEST="$CLAUDE_DIR/commands"
COMMAND_SENTINEL="<!-- devkit-managed: regenerated by devkit (do not edit) -->"
# Names reserved by the harness, colliding with third-party skills, or gated behind a token
# (plan-creator/plan-reviewer need `ralphex`, see plugins/core/hooks/skill-eval.txt) stay long-form.
SHORT_COMMAND_DENY=" browser coder design devkit-router git init learn plan plan-creator plan-reviewer review run verify "
mkdir -p "$COMMANDS_DEST"
for entry in "$COMMANDS_DEST"/*; do
  if [ -L "$entry" ]; then
    if links_into_devkit "$entry"; then
      rm -f "$entry"
    fi
  elif [ -f "$entry" ] && grep -qF "$COMMAND_SENTINEL" "$entry" 2>/dev/null; then
    rm -f "$entry"
  fi
done
cmd_count=0
short_count=0
foreign_names=""
authored_names=" "
if [ -d "$COMMANDS_SRC" ]; then
  for f in "$COMMANDS_SRC"/*.md; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    if [ -e "$COMMANDS_DEST/$base" ] || [ -L "$COMMANDS_DEST/$base" ]; then
      foreign_names="$foreign_names ${base%.md}"
      authored_names="$authored_names${base%.md} "
      continue
    fi
    ln -s "$f" "$COMMANDS_DEST/$base"
    authored_names="$authored_names${base%.md} "
    cmd_count=$((cmd_count + 1))
  done
fi
for d in "$core_skills_src"/*/; do
  [ -f "$d/SKILL.md" ] || continue
  n=$(basename "$d")
  case "$SHORT_COMMAND_DENY" in
    *" $n "*) continue ;;
  esac
  case "$authored_names" in
    *" $n "*) continue ;;
  esac
  dest="$COMMANDS_DEST/$n.md"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    foreign_names="$foreign_names $n"
    continue
  fi
  desc=$(awk '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    /^description:/ {
      v = $0
      sub(/^description:[[:space:]]*/, "", v)
      if (v ~ /^[>|]/) { v = "" }
      inblock = 1
      next
    }
    inblock && /^[A-Za-z_-]+:/ { exit }
    inblock {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      v = (v == "" ? line : v " " line)
    }
    END {
      if (length(v) > 150) { v = substr(v, 1, 150); sub(/[[:space:]][^[:space:]]*$/, "", v); v = v "…" }
      print v
    }
  ' "$d/SKILL.md")
  {
    printf -- '---\ndescription: >-\n  %s\n---\n\n' "$desc"
    printf '%s\n\n' "$COMMAND_SENTINEL"
    printf 'Activate `Skill(devkit-core--%s)` and follow it end to end.\n\n' "$n"
    printf 'Extra instructions from the user (may be empty): $ARGUMENTS\n'
  } > "$dest"
  short_count=$((short_count + 1))
done
echo "    Linked:  ~/.claude/commands/*.md ($cmd_count authored, $short_count generated short command(s))"
if [ -n "$foreign_names" ]; then
  echo "    NOTICE: kept your own ~/.claude/commands file(s) for:$foreign_names — those skills stay at /devkit-core--<name>."
fi

# --- Optional per-project adapters ---
if [ "$RUN_CURSOR" -eq 1 ]; then
  echo ""
  DEVKIT_PROJECT_ROOT="$PROJECT" bash "$DEVKIT_HOME/adapters/cursor/generate"
fi
if [ "$RUN_CODEX" -eq 1 ]; then
  echo ""
  DEVKIT_PROJECT_ROOT="$PROJECT" bash "$DEVKIT_HOME/adapters/codex/generate"
fi
if [ "$RUN_CLAUDE" -eq 1 ]; then
  echo ""
  DEVKIT_PROJECT_ROOT="$PROJECT" bash "$DEVKIT_HOME/adapters/claude/generate"
fi

echo ""
echo "Done. Restart Claude Code / Codex / Cursor (or start a new session) to load skills + the daily auto-update hook."
echo "Per project, keep .devkit/toolkit.json; the Codex adapter writes resolved skills under .codex/skills/."
