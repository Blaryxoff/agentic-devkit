#!/usr/bin/env bash
# devkit-update: fast-forward the global devkit clone.
#
# Usage:
#   devkit-update             Always pull (git pull --ff-only).
#   devkit-update --if-stale  Pull only if the last successful pull was > 24h ago.
#                             Used by the SessionStart hook installed by devkit-install.
#
# Operates on the clone this script lives in. Never fails the caller (always
# exits 0) so a SessionStart hook can't break a Claude session. Prints one
# status line.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEVKIT_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
STATE_FILE="$DEVKIT_HOME/.git/devkit-last-pull"
STALE_SECONDS=86400

if_stale=0
[ "${1:-}" = "--if-stale" ] && if_stale=1

now=$(date +%s)

if [ "$if_stale" -eq 1 ] && [ -f "$STATE_FILE" ]; then
  last=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
  case "$last" in ""|*[!0-9]*) last=0 ;; esac
  if [ $(( now - last )) -lt "$STALE_SECONDS" ]; then
    exit 0  # fresh — stay silent
  fi
fi

if ! git -C "$DEVKIT_HOME" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "devkit: $DEVKIT_HOME is not a git repo (skipping update)"
  exit 0
fi

before=$(git -C "$DEVKIT_HOME" rev-parse --short HEAD 2>/dev/null)
git -C "$DEVKIT_HOME" fetch -q 2>/dev/null

if git -C "$DEVKIT_HOME" pull --ff-only -q 2>/dev/null; then
  after=$(git -C "$DEVKIT_HOME" rev-parse --short HEAD 2>/dev/null)
  printf '%s' "$now" > "$STATE_FILE" 2>/dev/null || true
  if [ "$before" = "$after" ]; then
    echo "devkit: up to date ($after)"
  else
    echo "devkit: updated $before..$after"
  fi
else
  behind=$(git -C "$DEVKIT_HOME" rev-list --count HEAD..@{u} 2>/dev/null || echo "?")
  echo "devkit: $behind behind upstream — fast-forward failed, resolve manually in $DEVKIT_HOME"
  printf '%s' "$now" > "$STATE_FILE" 2>/dev/null || true  # don't nag every session
fi

exit 0
