#!/usr/bin/env bash
# devkit-resolve: resolve enabled plugins and optionally run an adapter.
#
# Usage:
#   devkit-resolve                     # List resolved plugin names
#   devkit-resolve --init              # Create .devkit/toolkit.json interactively
#   devkit-resolve --preset=<name>     # ... from examples/<name>.json, no prompts
#   devkit-resolve --enable=a,b        # ... from an explicit list, no prompts
#   devkit-resolve --dirs              # List resolved plugin directories
#   devkit-resolve --validate          # Validate configs against schemas/, then resolve
#   devkit-resolve --adapter=claude    # Resolve + generate Claude Code config
#   devkit-resolve --adapter=cursor    # Resolve + generate Cursor config
#   devkit-resolve --adapter=codex     # Resolve + generate Codex config
#
# Environment:
#   DEVKIT_PROJECT_ROOT  Override project root (default: CWD)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=../adapters/_lib/resolve.sh
source "$TOOLKIT_ROOT/adapters/_lib/resolve.sh"

usage() {
  cat <<'EOF'
devkit-resolve — resolve devkit-toolkit plugins for a project

Usage:
  devkit-resolve                     List resolved plugin names (one per line)
  devkit-resolve --init              Create .devkit/toolkit.json interactively
  devkit-resolve --preset=<name>     Create it from examples/<name>.json, no prompts
  devkit-resolve --enable=a,b        Create it from an explicit plugin list, no prompts
  devkit-resolve --dirs              List resolved plugin directories
  devkit-resolve --validate          Check every toolkit.json and plugin.json against
                                   schemas/, then resolve
  devkit-resolve --adapter=<name>    Resolve + generate config for an adapter
                                   Supported: claude, cursor, codex

Options:
  -h, --help      Show this help
  --project=DIR   Override project root (default: CWD). Repeatable: pass multiple
                  --project=DIR to union plugins across repos (backend+frontend).

Environment:
  DEVKIT_PROJECT_ROOT   Same as --project
EOF
  exit "${1:-0}"
}

INIT_PRESET=""
INIT_ENABLE=""
INIT_NONINTERACTIVE=0
INIT_PRESET_GIVEN=0
MODE="list"
ADAPTER=""

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      ;;
    --init)
      MODE="init"
      ;;
    --preset=*)
      MODE="init"
      INIT_NONINTERACTIVE=1
      INIT_PRESET_GIVEN=1
      INIT_PRESET="${arg#--preset=}"
      ;;
    --enable=*)
      MODE="init"
      INIT_NONINTERACTIVE=1
      INIT_ENABLE="${arg#--enable=}"
      ;;
    --validate)
      MODE="validate"
      ;;
    --dirs)
      MODE="dirs"
      ;;
    --adapter=*)
      MODE="adapter"
      ADAPTER="${arg#--adapter=}"
      ;;
    --project=*)
      _root="${arg#--project=}"
      DEVKIT_PROJECT_ROOTS="${DEVKIT_PROJECT_ROOTS:+$DEVKIT_PROJECT_ROOTS:}$_root"
      ;;
    *)
      echo "Unknown option: $arg" >&2
      usage 1
      ;;
  esac
done

# Repeated --project flags accumulate into DEVKIT_PROJECT_ROOTS (':'-separated)
# so the resolver can union multiple repos (backend + frontend). The first root
# is the primary PROJECT_ROOT used for error hints and per-project adapter output.
if [ -n "${DEVKIT_PROJECT_ROOTS:-}" ]; then
  export DEVKIT_PROJECT_ROOTS
  PROJECT_ROOT="${DEVKIT_PROJECT_ROOTS%%:*}"
  export DEVKIT_PROJECT_ROOT="$PROJECT_ROOT"
fi

_init_toolkit() {
  local config_dir="$PROJECT_ROOT/.devkit"
  local config_file="$config_dir/toolkit.json"

  if [ -f "$config_file" ]; then
    echo "ERROR: $config_file already exists." >&2
    exit 1
  fi

  local relpath
  relpath=$(toolkit_relpath)
  local schema_ref="$relpath/schemas/toolkit.schema.json"

  local examples_dir="$TOOLKIT_ROOT/examples"
  local -a preset_files=()
  local -a preset_labels=()

  # --preset / --enable skip the prompts entirely, so this command is reachable from
  # a script, a container bootstrap, or a test. Everything below stays interactive.
  if [ "$INIT_NONINTERACTIVE" -eq 1 ]; then
    local enabled_json
    if [ "$INIT_PRESET_GIVEN" -eq 1 ] && [ -z "$INIT_PRESET" ]; then
      echo "ERROR: --preset needs a name, e.g. --preset=laravel-only" >&2
      exit 1
    fi
    if [ -n "$INIT_ENABLE" ] || [ -z "$INIT_PRESET" ]; then
      enabled_json=$(printf '%s' "$INIT_ENABLE" | jq -R 'split(",") | map(select(length > 0))')
      # An empty --enable= must be an error, not a silent fall-through to the prompts:
      # this flag exists for contexts where nothing can answer them.
      if [ -z "$enabled_json" ] || [ "$(printf '%s' "$enabled_json" | jq 'length')" -eq 0 ]; then
        echo "ERROR: --enable needs at least one plugin name, e.g. --enable=devkit-laravel" >&2
        exit 1
      fi
    else
      local preset_file="$examples_dir/$INIT_PRESET.json"
      if [ ! -f "$preset_file" ]; then
        echo "ERROR: no preset '$INIT_PRESET'. Available:" >&2
        for f in "$examples_dir"/*.json; do
          [ -f "$f" ] && echo "  - $(basename "$f" .json)" >&2
        done
        exit 1
      fi
      enabled_json=$(jq '.enabled' "$preset_file")
    fi

    local candidate
    candidate=$(jq -n --arg schema "$schema_ref" --argjson enabled "$enabled_json" \
      '{"$schema": $schema, version: 1, enabled: $enabled}')

    # Check the candidate in a throwaway root before it reaches the project. A bad
    # --enable would otherwise leave a config behind that --init then refuses to
    # replace, so a typo could only be undone by deleting the file by hand.
    local probe
    probe=$(mktemp -d) || exit 1
    mkdir -p "$probe/.devkit"
    printf '%s\n' "$candidate" > "$probe/.devkit/toolkit.json"
    if ! ( PROJECT_ROOT="$probe" DEVKIT_PROJECT_ROOTS="$probe" validate_schemas >/dev/null \
             2> >(sed "s#$probe/.devkit/toolkit.json#$config_file#g" >&2) ) ||
       ! ( PROJECT_ROOT="$probe" DEVKIT_PROJECT_ROOTS="$probe" resolve_plugins >/dev/null ); then
      rm -rf "$probe"
      echo "ERROR: refusing to write $config_file — that plugin set does not resolve." >&2
      exit 1
    fi
    rm -rf "$probe"

    mkdir -p "$config_dir"
    write_json "$config_file" "$candidate" || exit 1
    echo "Created: .devkit/toolkit.json"
    resolve_plugins | while read -r name; do echo "  - $name"; done
    return 0
  fi

  # Everything below prompts. Without a terminal `read` never returns, and an agent
  # harness detaches the call instead of killing it, so the shell survives the turn.
  if [ ! -t 0 ]; then
    echo "ERROR: --init needs a terminal. Use --preset=<name> or --enable=a,b instead." >&2
    exit 1
  fi

  for f in "$examples_dir"/*.json; do
    [ -f "$f" ] || continue
    local base
    base=$(basename "$f" .json)
    local desc
    desc=$(jq -r '.enabled | join(", ")' "$f")
    preset_files+=("$f")
    preset_labels+=("$base  ($desc)")
  done

  echo ""
  echo "Available presets:"
  local i=1
  for label in "${preset_labels[@]}"; do
    echo "  $i) $label"
    ((i++))
  done
  echo "  $i) custom — pick plugins manually"
  echo ""

  local total=${#preset_files[@]}
  local choice
  read -rp "Select preset [1-$((total + 1))]: " choice

  local enabled_json

  if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$total" ] 2>/dev/null; then
    enabled_json=$(jq '.enabled' "${preset_files[$((choice - 1))]}")
  elif [ "$choice" -eq $((total + 1)) ] 2>/dev/null; then
    local -a all_plugins=()
    for manifest in "$TOOLKIT_ROOT"/plugins/*/plugin.json; do
      [ -f "$manifest" ] || continue
      local pname pdesc player pdefault
      pname=$(jq -r '.name' "$manifest")
      pdesc=$(jq -r '.description' "$manifest")
      player=$(jq -r '.layer' "$manifest")
      pdefault=$(jq -r '.defaultEnabled // false' "$manifest")
      [ "$pdefault" = "true" ] && continue
      all_plugins+=("$pname|$pdesc|$player")
    done

    echo ""
    echo "Available plugins (devkit-core is always included):"
    i=1
    for entry in "${all_plugins[@]}"; do
      local pname pdesc player
      pname=$(echo "$entry" | cut -d'|' -f1)
      pdesc=$(echo "$entry" | cut -d'|' -f2)
      player=$(echo "$entry" | cut -d'|' -f3)
      echo "  $i) $pname [$player] — $pdesc"
      ((i++))
    done
    echo ""

    local selections
    read -rp "Enter plugin numbers separated by spaces: " selections

    enabled_json="[]"
    for sel in $selections; do
      if [ "$sel" -ge 1 ] 2>/dev/null && [ "$sel" -le ${#all_plugins[@]} ] 2>/dev/null; then
        local selected_name
        selected_name=$(echo "${all_plugins[$((sel - 1))]}" | cut -d'|' -f1)
        enabled_json=$(echo "$enabled_json" | jq --arg n "$selected_name" '. + [$n]')
      fi
    done
  else
    echo "Invalid selection." >&2
    exit 1
  fi

  mkdir -p "$config_dir"
  jq -n \
    --arg schema "$schema_ref" \
    --argjson enabled "$enabled_json" \
    '{"$schema": $schema, version: 1, enabled: $enabled}' > "$config_file"

  echo ""
  echo "Created: .devkit/toolkit.json"
  echo ""

  local resolved
  resolved=$(resolve_plugins)
  echo "Resolved plugins:"
  echo "$resolved" | while read -r name; do echo "  - $name"; done

  local relpath
  relpath=$(toolkit_relpath)
  echo ""
  echo "Next step: generate config for your IDE/tool:"
  echo ""
  echo "  $relpath/bin/devkit-resolve --adapter=claude"
  echo "  $relpath/bin/devkit-resolve --adapter=cursor"
  echo "  $relpath/bin/devkit-resolve --adapter=codex"
}

case "$MODE" in
  init)
    _init_toolkit
    ;;
  validate)
    if ! manifests=$(validate_schemas); then
      echo "FAILED: schema validation" >&2
      exit 1
    fi
    resolved=$(resolve_plugins) || exit 1
    count=$(echo "$resolved" | wc -l | tr -d ' ')
    echo "OK: toolkit.json + $manifests plugin manifest(s) match schemas/ (targeted, not full JSON Schema conformance)"
    echo "OK: $count plugins resolved"
    echo "$resolved" | while read -r name; do echo "  - $name"; done
    ;;
  dirs)
    resolve_plugin_dirs
    ;;
  list)
    resolve_plugins
    ;;
  adapter)
    adapter_script="$TOOLKIT_ROOT/adapters/$ADAPTER/generate"
    if [[ ! -f "$adapter_script" ]]; then
      echo "ERROR: Unknown adapter '$ADAPTER'. Available:" >&2
      for d in "$TOOLKIT_ROOT"/adapters/*/generate; do
        [[ -f "$d" ]] && echo "  - $(basename "$(dirname "$d")")" >&2
      done
      exit 1
    fi
    exec bash "$adapter_script"
    ;;
esac
