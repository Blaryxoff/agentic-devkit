#!/usr/bin/env bash
# devkit-plan-loop: iterate /plan-reviewer across claude and codex on a ralphex plan.
#
# Usage:
#   devkit-plan-loop <plan-path> [total=5] [verified=2]
#
# Arguments:
#   plan-path   Path to the ralphex plan markdown file to review.
#   total       Total iterations. Each iteration is one claude run followed
#               by one codex run (so total=5 means 10 reviewer invocations).
#               Default: 5.
#   verified    First N iterations run interactively so you can answer the
#               reviewer's questions and pick which recommendations to accept.
#               Remaining (total - verified) iterations run headless and
#               auto-accept proposed edits. Default: 2.
#
# Each invocation starts with a fresh CLI process, so context is cleared
# between runs the same way you do manually.

set -euo pipefail

usage() {
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

[[ $# -ge 1 ]] || usage
case "${1:-}" in -h|--help) usage 0 ;; esac

PLAN="$1"
TOTAL="${2:-5}"
VERIFIED="${3:-2}"

if [[ ! -f "$PLAN" ]]; then
  echo "devkit-plan-loop: plan not found: $PLAN" >&2
  exit 1
fi
if ! [[ "$TOTAL" =~ ^[0-9]+$ ]] || (( TOTAL < 1 )); then
  echo "devkit-plan-loop: total must be a positive integer (got: $TOTAL)" >&2
  exit 1
fi
if ! [[ "$VERIFIED" =~ ^[0-9]+$ ]] || (( VERIFIED > TOTAL )); then
  echo "devkit-plan-loop: verified must be between 0 and total ($TOTAL) (got: $VERIFIED)" >&2
  exit 1
fi

command -v claude >/dev/null 2>&1 || { echo "devkit-plan-loop: 'claude' CLI not found in PATH" >&2; exit 1; }
command -v codex  >/dev/null 2>&1 || { echo "devkit-plan-loop: 'codex' CLI not found in PATH" >&2; exit 1; }

# Slash command form. Plugin skills are namespaced in both CLIs (e.g. /devkit-core:plan-reviewer).
# The short /plan-reviewer only resolves via interactive typeahead, not when passed as initial prompt.
# Override per-CLI with env vars if your project uses a different namespace.
CLAUDE_CMD="${CLAUDE_PLAN_REVIEWER_CMD:-/devkit-core:plan-reviewer}"
CODEX_CMD="${CODEX_PLAN_REVIEWER_CMD:-/devkit-core:plan-reviewer}"

LOG_DIR=".devkit/plan-loop-logs"
mkdir -p "$LOG_DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"

printf 'devkit-plan-loop: plan=%s total=%d verified=%d (one iter = claude + codex)\n' \
  "$PLAN" "$TOTAL" "$VERIFIED"
printf 'logs: %s/%s-*\n\n' "$LOG_DIR" "$STAMP"

run_reviewer() {
  local reviewer="$1" mode="$2" iter="$3"
  local log
  log="$LOG_DIR/${STAMP}-iter$(printf '%02d' "$iter")-${reviewer}-${mode}.log"

  printf '\n--- iter %d/%d  reviewer=%s  mode=%s ---\n' "$iter" "$TOTAL" "$reviewer" "$mode"

  case "$reviewer:$mode" in
    claude:verified) claude "$CLAUDE_CMD $PLAN" ;;
    claude:trusted)  claude -p "$CLAUDE_CMD $PLAN" --permission-mode acceptEdits 2>&1 | tee "$log" ;;
    codex:verified)  codex "$CODEX_CMD $PLAN" ;;
    codex:trusted)   codex exec --full-auto "$CODEX_CMD $PLAN" 2>&1 | tee "$log" ;;
  esac
}

for ((i = 1; i <= TOTAL; i++)); do
  if (( i <= VERIFIED )); then mode="verified"; else mode="trusted"; fi

  printf '\n=== iter %d/%d  mode=%s ===\n' "$i" "$TOTAL" "$mode"

  run_reviewer claude "$mode" "$i"
  run_reviewer codex  "$mode" "$i"
done

printf '\ndevkit-plan-loop: done. Logs in %s\n' "$LOG_DIR"
